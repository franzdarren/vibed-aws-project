# Copy this file to .env and fill in real values. Never commit .env.

FLASK_SECRET_KEY=change-me-to-something-random

# AWS credentials (leave blank if using an IAM role / `aws configure` profile instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3
S3_BUCKET_NAME=your-photo-bucket-name

# DynamoDB
DYNAMODB_TABLE_NAME=photos

# MobileNetV2 classifier
CLASSIFIER_MODEL=google/mobilenet_v2_1.0_224
CLASSIFIER_TOP_K=5
CLASSIFIER_MIN_SCORE=0.15

# Downscale photos to this many px on the longest side before storing in S3.
# Set to 0 to store originals untouched.
RESIZE_MAX_DIMENSION=1600
